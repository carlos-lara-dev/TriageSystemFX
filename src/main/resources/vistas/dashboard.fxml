<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="page-root"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="triagesystem.DashboardController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Título -->
    <Label text="Inicio" styleClass="page-title"/>
    <Label fx:id="lblFecha" styleClass="page-subtitle"/>

    <!-- Tarjetas KPI -->
    <HBox spacing="12">
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="En espera" styleClass="kpi-label"/>
            <Label fx:id="lblEnEspera" text="—" styleClass="kpi-value-blue"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="En consulta" styleClass="kpi-label"/>
            <Label fx:id="lblEnConsulta" text="—" styleClass="kpi-value-amber"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Críticos" styleClass="kpi-label"/>
            <Label fx:id="lblCriticos" text="—" styleClass="kpi-value-red"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Atendidos hoy" styleClass="kpi-label"/>
            <Label fx:id="lblAtendidos" text="—" styleClass="kpi-value-green"/>
        </VBox>
    </HBox>

    <!-- Tabla de próximos -->
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-card-header">
            <Label text="Próximos en atender" styleClass="table-card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12" alignment="CENTER">
                <HBox spacing="5" alignment="CENTER"><Region style="-fx-background-color:#fde68a;-fx-background-radius:3;-fx-min-width:10;-fx-min-height:10;-fx-pref-width:10;-fx-pref-height:10;-fx-max-width:10;-fx-max-height:10;"/><Label text="En espera"   styleClass="legend-label"/></HBox>
                <HBox spacing="5" alignment="CENTER"><Region style="-fx-background-color:#bfdbfe;-fx-background-radius:3;-fx-min-width:10;-fx-min-height:10;-fx-pref-width:10;-fx-pref-height:10;-fx-max-width:10;-fx-max-height:10;"/><Label text="En consulta" styleClass="legend-label"/></HBox>
                <HBox spacing="5" alignment="CENTER"><Region style="-fx-background-color:#bbf7d0;-fx-background-radius:3;-fx-min-width:10;-fx-min-height:10;-fx-pref-width:10;-fx-pref-height:10;-fx-max-width:10;-fx-max-height:10;"/><Label text="Atendido"    styleClass="legend-label"/></HBox>
                <HBox spacing="5" alignment="CENTER"><Region style="-fx-background-color:#fecdd3;-fx-background-radius:3;-fx-min-width:10;-fx-min-height:10;-fx-pref-width:10;-fx-pref-height:10;-fx-max-width:10;-fx-max-height:10;"/><Label text="Cancelado"   styleClass="legend-label"/></HBox>
            </HBox>
            <Button text="Ver cola completa" styleClass="btn-primary" onAction="#irACola"/>
        </HBox>
        <TableView fx:id="tablaProximos" VBox.vgrow="ALWAYS" styleClass="triage-table">
            <columns>
                <TableColumn fx:id="colPos"       text="#"         prefWidth="40"/>
                <TableColumn fx:id="colNombre"    text="Paciente"  prefWidth="200"/>
                <TableColumn fx:id="colPrioridad" text="Prioridad" prefWidth="110"/>
                <TableColumn fx:id="colEspera"    text="Espera"    prefWidth="100"/>
                <TableColumn fx:id="colEstado"    text="Estado"    prefWidth="120"/>
            </columns>
            <placeholder><Label text="No hay pacientes en cola" styleClass="table-placeholder"/></placeholder>
        </TableView>
    </VBox>
</VBox>
